# ── App ──────────────────────────────────────────────────────────
APPENV=
APPURL=
APPPORT=
WEBURL=      # Public URL of the web frontend (browser-facing) - used to build deep links in outbound alerts (e.g. Telegram). Leave blank to omit links.

AGENTVERSION=
AUTOUPDATEAGENT=           # true to push agent.exe (matching AGENTVERSION) to all machines when they connect with a different version
ENFORCEMFA=

# ── Auth ─────────────────────────────────────────────────────────
JWTSECRET=
BOOTSTRAPTOKEN=
DEFAULTADMINUSERNAME=
DEFAULTADMINPASSWORD=

# ── Database ─────────────────────────────────────────────────────
DATABASETYPE=
DATABASEPATH=
DATABASEHOST=
DATABASEPORT=
DATABASENAME=
DATABASEUSERNAME=
DATABASEPASSWORD=
DATABASEUSESSL=

# ── Cache ─────────────────────────────────────────────────────────
CACHETYPE=
REDISADDR=
REDISPASSWORD=
REDISDB=

# ── Loki ─────────────────────────────────────────────────────────
LOKIHOST=
LOKIPORT=
LOKITLSENABLED=
LOKITLSSKIPVERIFY=

# ── Casbin ───────────────────────────────────────────────────────
MODELCONFPATH=
POLICYCSVPATH=

# ── Alertmanager ─────────────────────────────────────────────────
ALERTMANAGERURL=

# ── Alerts ───────────────────────────────────────────────────────
# Per-alert-type severity overrides, pre-filled with the built-in default from
# internal/domain/notification/alert_types.go - edit any line to change it.
# Values: info | warning | critical | sev | disabled ("disabled" = never even created).
ALERTSEVERITY_MACHINECONNECTED=info
ALERTSEVERITY_MACHINEDISCONNECTED=sev
ALERTSEVERITY_MACHINESHUTDOWN=info
ALERTSEVERITY_MACHINERESTARTING=info
ALERTSEVERITY_AGENTUPDATED=info
ALERTSEVERITY_APPPOOLSTOPPED=critical
ALERTSEVERITY_APPPOOLSTARTED=info
ALERTSEVERITY_SITESTOPPED=critical
ALERTSEVERITY_SITESTARTED=info
ALERTSEVERITY_WINDOWSEXPORTERDOWN=critical
ALERTSEVERITY_WINDOWSEXPORTERUP=info
ALERTSEVERITY_FLUENTBITDOWN=critical
ALERTSEVERITY_FLUENTBITUP=info
ALERTSEVERITY_HEALTHCHECKDOWN=critical
ALERTSEVERITY_HEALTHCHECKUP=info
ALERTSEVERITY_HIGHCPU=warning
ALERTSEVERITY_HIGHCPURECOVERED=info
ALERTSEVERITY_HIGHMEMORY=warning
ALERTSEVERITY_HIGHMEMORYRECOVERED=info
ALERTSEVERITY_LOWDISK=critical
ALERTSEVERITY_LOWDISKRECOVERED=info

# Numeric thresholds for the metric-based alerts, pre-filled with the hardcoded default
# from internal/application/metrics/checker.go.
THRESHOLD_HIGHCPU_PERCENT=90
THRESHOLD_HIGHMEMORY_PERCENT=90
THRESHOLD_LOWDISK_PERCENT=10       # alert fires when free space drops BELOW this

# Only alerts at or above this severity are forwarded to Alertmanager (everything
# non-disabled is still stored/shown in-app regardless).
ALERTRECEIVERMINSEVERITY=warning

# ── Docker Compose only ───────────────────────────────────────────
WIMP_TAG=latest
WIMP_WEB_TAG=latest
WIMP_API_PORT=8080
WIMP_WEB_PORT=80
PROMETHEUS_URL=      # Public URL of Prometheus - shown in the web UI metrics page
GRAFANA_PASSWORD=
