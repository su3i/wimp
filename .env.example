# ── App ──────────────────────────────────────────────────────────
APPENV=
APPURL=
APPPORT=
WEBURL=      # Public URL of the web frontend (browser-facing) - used to build deep links in outbound alerts (e.g. Telegram). Leave blank to omit links.

AGENTVERSION=1.0.3
AUTOUPDATEAGENT=           # true to push agent.exe (matching AGENTVERSION) to all machines when they connect with a different version
ENFORCEMFA=

# ── Auth ─────────────────────────────────────────────────────────
JWTSECRET=
BOOTSTRAPTOKEN=
DEFAULTADMINUSERNAME=
DEFAULTADMINPASSWORD=

# ── Database ─────────────────────────────────────────────────────
DATABASETYPE=
DATABASEPATH=
DATABASEHOST=
DATABASEPORT=
DATABASENAME=
DATABASEUSERNAME=
DATABASEPASSWORD=
DATABASEUSESSL=

# ── Cache ─────────────────────────────────────────────────────────
CACHETYPE=
REDISADDR=
REDISPASSWORD=
REDISDB=

# ── Loki ─────────────────────────────────────────────────────────
LOKIHOST=
LOKIPORT=
LOKITLSENABLED=
LOKITLSSKIPVERIFY=

# ── Casbin ───────────────────────────────────────────────────────
MODELCONFPATH=
POLICYCSVPATH=

# ── Alertmanager ─────────────────────────────────────────────────
ALERTMANAGERURL=

# ── SQL Server monitoring ────────────────────────────────────────
# One SQL login, created with the same name and password on every instance, granted:
#   GRANT VIEW SERVER STATE TO [login]; GRANT VIEW ANY DEFINITION TO [login];
#   USE msdb; ALTER ROLE db_datareader ADD MEMBER [user];
# Leave both empty to use Windows authentication instead: grant the same to
# [NT AUTHORITY\SYSTEM], the account the agent runs as. Planned AG failover additionally needs
# ALTER ANY AVAILABILITY GROUP (SYSTEM normally has it on AG replicas already).
# Without either, SQL instances still report state and alerts, but not DMV metrics
# (waits, blocking, backups, jobs, AG health).
SQLMONITORUSERNAME=
SQLMONITORPASSWORD=

# ── Alerts ───────────────────────────────────────────────────────
# Per-alert-type severity overrides, pre-filled with the built-in default from
# internal/domain/notification/alert_types.go - edit any line to change it.
# Values: info | warning | critical | sev | disabled ("disabled" = never even created).
ALERTSEVERITY_MACHINECONNECTED=info
ALERTSEVERITY_MACHINEDISCONNECTED=sev
ALERTSEVERITY_MACHINERESTARTING=info
ALERTSEVERITY_AGENTUPDATED=info
ALERTSEVERITY_MACHINEREASSIGNED=warning
ALERTSEVERITY_APPPOOLSTOPPED=critical
ALERTSEVERITY_APPPOOLSTARTED=info
ALERTSEVERITY_SITESTOPPED=critical
ALERTSEVERITY_SITESTARTED=info
ALERTSEVERITY_WINDOWSEXPORTERDOWN=critical
ALERTSEVERITY_WINDOWSEXPORTERUP=info
ALERTSEVERITY_FLUENTBITDOWN=critical
ALERTSEVERITY_FLUENTBITUP=info
ALERTSEVERITY_HEALTHCHECKDOWN=critical
ALERTSEVERITY_HEALTHCHECKUP=info
ALERTSEVERITY_HEALTHCHECKSLOW=critical
ALERTSEVERITY_HEALTHCHECKSLOWRECOVERED=info
ALERTSEVERITY_HIGHCPU=warning
ALERTSEVERITY_HIGHCPURECOVERED=info
ALERTSEVERITY_HIGHMEMORY=warning
ALERTSEVERITY_HIGHMEMORYRECOVERED=info
ALERTSEVERITY_LOWDISK=critical
ALERTSEVERITY_LOWDISKRECOVERED=info
ALERTSEVERITY_SQLINSTANCESTOPPED=sev
ALERTSEVERITY_SQLINSTANCESTARTED=info
ALERTSEVERITY_SQLAGENTSTOPPED=critical
ALERTSEVERITY_SQLAGENTSTARTED=info
ALERTSEVERITY_SQLINSTANCEFAILOVER=warning
ALERTSEVERITY_SQLAGFAILOVER=warning
ALERTSEVERITY_SQLDATABASEUNHEALTHY=sev
ALERTSEVERITY_SQLDATABASERECOVERED=info
ALERTSEVERITY_SQLBACKUPOVERDUE=critical
ALERTSEVERITY_SQLBACKUPRECOVERED=info
ALERTSEVERITY_SQLLOGBACKUPOVERDUE=critical
ALERTSEVERITY_SQLLOGBACKUPRECOVERED=info
ALERTSEVERITY_SQLJOBFAILED=warning
ALERTSEVERITY_SQLJOBRECOVERED=info
ALERTSEVERITY_SQLAGUNHEALTHY=critical
ALERTSEVERITY_SQLAGHEALTHY=info
ALERTSEVERITY_SQLBLOCKING=warning
ALERTSEVERITY_SQLBLOCKINGCLEARED=info
ALERTSEVERITY_CLUSTERNODEDOWN=critical
ALERTSEVERITY_CLUSTERNODEUP=info

# Numeric thresholds for the metric-based alerts, pre-filled with the hardcoded default
# from internal/application/metrics/checker.go.
THRESHOLD_HIGHCPU_PERCENT=90
THRESHOLD_HIGHMEMORY_PERCENT=90
THRESHOLD_LOWDISK_PERCENT=10       # alert fires when free space drops BELOW this

# SQL Server thresholds (need SQL credentials or Windows auth, see SQLMONITOR* below).
THRESHOLD_SQL_BACKUP_HOURS=26          # since the last full or differential backup
THRESHOLD_SQL_LOG_BACKUP_MINUTES=120   # since the last log backup, FULL/BULK_LOGGED databases only
THRESHOLD_SQL_BLOCKING_SECONDS=60      # longest a request may be blocked

# Health check timing. HEALTHCHECK_TIMEOUT_SECONDS is how long a probe may run before it
# counts as a failure - keep it generous, since a probe that times out is recorded exactly
# like an endpoint that refused the connection, which is what makes a slow site look down.
# It is clamped down automatically for applications whose check interval is shorter.
# THRESHOLD_HEALTHCHECK_SLOW_SECONDS is the response time above which a site that IS
# responding is alerted on as degraded; keep it well below the timeout.
HEALTHCHECK_TIMEOUT_SECONDS=30
THRESHOLD_HEALTHCHECK_SLOW_SECONDS=5

# Only alerts at or above this severity are forwarded to Alertmanager (everything
# non-disabled is still stored/shown in-app regardless).
ALERTRECEIVERMINSEVERITY=warning

# ── Docker Compose only ───────────────────────────────────────────
WIMP_TAG=1.1.0
WIMP_WEB_TAG=1.1.0
WIMP_API_PORT=8080
WIMP_WEB_PORT=80
PROMETHEUS_URL=      # Public URL of Prometheus - shown in the web UI metrics page
GRAFANA_PASSWORD=
