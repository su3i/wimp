# ── App ──────────────────────────────────────────────────────────
APPENV=
APPURL=
APPPORT=

AGENTVERSION=
AUTOUPDATEAGENT=           # true to push agent.exe (matching AGENTVERSION) to all machines when they connect with a different version
ENFORCEMFA=

# ── Auth ─────────────────────────────────────────────────────────
JWTSECRET=
BOOTSTRAPTOKEN=
DEFAULTADMINUSERNAME=
DEFAULTADMINPASSWORD=

# ── Database ─────────────────────────────────────────────────────
DATABASETYPE=
DATABASEPATH=
DATABASEHOST=
DATABASEPORT=
DATABASENAME=
DATABASEUSERNAME=
DATABASEPASSWORD=
DATABASEUSESSL=

# ── Cache ─────────────────────────────────────────────────────────
CACHETYPE=
REDISADDR=
REDISPASSWORD=
REDISDB=

# ── Loki ─────────────────────────────────────────────────────────
LOKIHOST=
LOKIPORT=
LOKITLSENABLED=
LOKITLSSKIPVERIFY=

# ── Casbin ───────────────────────────────────────────────────────
MODELCONFPATH=
POLICYCSVPATH=

# ── Alertmanager ─────────────────────────────────────────────────
ALERTMANAGERURL=

# ── Docker Compose only ───────────────────────────────────────────
WIMP_TAG=latest
WIMP_WEB_TAG=latest
WIMP_API_PORT=8080
WIMP_WEB_PORT=80
PROMETHEUS_URL=      # Public URL of Prometheus - shown in the web UI metrics page
