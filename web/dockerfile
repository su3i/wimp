# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Build with fixed placeholders - replaced at runtime by docker-entrypoint.sh
ENV VITE_API_BASE_URL=__WIMP_API_URL__
ENV VITE_PROMETHEUS_URL=__WIMP_PROMETHEUS_URL__
RUN npm run build

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

RUN apk add --no-cache gzip

COPY --from=builder /app/dist /usr/share/nginx/html

# Pre-compress static assets at build time so nginx's gzip_static module can serve
# them straight off disk (max compression, zero request-time CPU cost) instead of
# gzipping on the fly. JS is deliberately excluded here - docker-entrypoint.sh patches
# runtime env vars into the JS files at container start, so compressing now would bake
# in the placeholder values; JS gets gzipped there instead, after the substitution.
RUN find /usr/share/nginx/html -type f \( -name '*.css' -o -name '*.svg' -o -name '*.html' -o -name '*.json' -o -name '*.woff2' -o -name '*.woff' \) -exec gzip -9 -k -f {} \;

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY docker-entrypoint.sh /docker-entrypoint.sh

RUN chmod +x /docker-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
